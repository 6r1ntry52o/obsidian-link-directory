{
  "name": "obsidian-link-directory",
  "version": "0.10.0",
  "description": "Browse the link structure of your notes as a directory tree, styled like the File Explorer.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "node esbuild.config.mjs production && node scripts/deploy.mjs",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "^1.13.1",
    "tslib": "2.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
